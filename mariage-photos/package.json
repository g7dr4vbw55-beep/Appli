{
  "name": "mariage-photos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:manifest": "node --experimental-strip-types scripts/generate-manifest.mjs",
    "generate:config": "npm run generate:icons && npm run generate:manifest",
    "predev": "npm run generate:config",
    "dev": "vite",
    "prebuild": "npm run generate:config",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "archiver": "^8.0.0",
    "browser-image-compression": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.10.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
