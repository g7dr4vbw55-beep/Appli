# =============================================================================
# MODÈLE — NE JAMAIS ÉCRIRE DE VRAIE VALEUR DANS CE FICHIER.
#
# Ce fichier est un exemple, suivi par git et publié sur GitHub : tout ce que
# vous y écrivez devient public. Il sert uniquement à lister les variables
# nécessaires, avec des valeurs vides.
#
# Où mettre vos vraies valeurs :
#   - En production : dans Vercel > Project Settings > Environment Variables.
#   - En local (ordinateur) : dans un fichier nommé ".env", que git ignore.
#     Créez-le avec :  cp .env.example .env
#
# Le README explique précisément où récupérer chaque valeur.
# =============================================================================

# --- Supabase (Project Settings > API Keys dans votre projet Supabase) ------

# "Project URL" — l'adresse de base SEULEMENT, sans rien ajouter derrière.
# Correct   : https://xxxxxxxxxxxx.supabase.co
# Incorrect : https://xxxxxxxxxxxx.supabase.co/rest/v1/
VITE_SUPABASE_URL=

# Clé "Publishable key", ex : sb_publishable_xxxxxxxxxxxx
# (Si votre projet n'affiche que les anciennes clés, marquées LEGACY, prenez
# alors "anonymous API key" : l'application accepte les deux formats.)
# Cette clé est visible côté navigateur, c'est normal : la sécurité est
# assurée par les policies RLS définies dans supabase/schema.sql
VITE_SUPABASE_ANON_KEY=

# Nom du bucket de stockage créé par le script SQL (voir README)
VITE_SUPABASE_BUCKET=photos

# --- Accès invités ------------------------------------------------------------

# Code d'accès partagé, à écrire sur les affiches posées sur les tables.
# Choisissez un mot simple à taper sur mobile, par exemple le prénom des
# mariés ou la date. Ne mettez rien de secret : il est visible dans le code
# de l'application (c'est juste un filtre contre les visites accidentelles).
VITE_ACCESS_CODE=

# --- Administration -------------------------------------------------------

# Partie de l'URL d'administration : la page sera accessible sur
# https://votre-site.vercel.app/<VITE_ADMIN_PATH>
# Choisissez une chaîne longue et difficile à deviner, par exemple générée
# avec : node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
VITE_ADMIN_PATH=admin-a1b2c3d4

# Mot de passe de la page d'administration. IMPORTANT : contrairement aux
# variables VITE_*, celle-ci n'est jamais envoyée au navigateur : elle n'est
# lue que par les fonctions serveur (dossier api/). Choisissez un mot de
# passe robuste, différent de vos mots de passe personnels.
ADMIN_PASSWORD=

# Clé "Secret key (default)", ex : sb_secret_xxxxxxxxxxxx
# (Ou l'ancienne "service API key" si votre projet n'affiche que les clés
# marquées LEGACY : l'application accepte les deux formats.)
# ATTENTION : cette clé donne un accès total à votre base et à votre stockage.
# Ne la mettez JAMAIS dans une variable préfixée VITE_ (elle serait alors
# visible par tout le monde). Elle n'est utilisée que côté serveur, dans api/.
SUPABASE_SERVICE_ROLE_KEY=
