# ---------------------------------------------------------------------------
# Configuration de l'application de formation a l'investissement
# Copiez ce fichier en .env a la racine du projet puis renseignez vos cles.
# Le fichier .env n'est jamais versionne (voir .gitignore).
# ---------------------------------------------------------------------------

# --- Serveur ---------------------------------------------------------------
PORT=3001
# Chemin de la base SQLite (relatif a la racine du dossier server/)
DATABASE_PATH=./data/formation.db

# --- Module 4 : decrypteur d'actualite (API Anthropic) ---------------------
# Obligatoire uniquement pour le decrypteur. Le reste de l'application
# fonctionne sans cette cle. Cle a creer sur https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modele utilise pour le decryptage.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Module 2 : cotations actions et ETF -----------------------------------
# Fournisseur de cotations : finnhub | alphavantage | manual
# "manual" desactive tout appel reseau pour les actions/ETF : les prix sont
# alors saisis a la main dans l'application (mode degrade permanent).
EQUITY_PROVIDER=manual
# Cle gratuite Finnhub : https://finnhub.io/register
FINNHUB_API_KEY=
# Cle gratuite Alpha Vantage : https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Module 2 : cotations crypto -------------------------------------------
# CoinGecko fonctionne sans cle sur son offre publique (limite de debit).
# Renseignez une cle Demo/Pro uniquement si vous en possedez une.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- Module 2 : parametres de simulation -----------------------------------
# Capital virtuel de depart, en euros.
STARTING_CASH=10000
# Frais de transaction simules : pourcentage du montant de l'ordre.
FEE_PERCENT=0.35
# Frais fixes simules par ordre, en euros.
FEE_FIXED=1.00
# Seuil d'alerte de concentration d'une position, en pourcentage du portefeuille.
CONCENTRATION_ALERT_PERCENT=20
